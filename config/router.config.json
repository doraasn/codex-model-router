{
  "host": "127.0.0.1",
  "port": 4010,
  "maxBodyBytes": 67108864,
  "requestTimeoutMs": 600000,
  "providers": [
    {
      "id": "chatgpt",
      "baseUrl": "https://chatgpt.com/backend-api/codex/",
      "auth": { "type": "chatgpt" },
      "match": { "prefixes": ["gpt-", "codex-"] },
      "transforms": ["chatgpt-history"],
      "retryOnPromptCacheError": true
    },
    {
      "id": "deepseek",
      "baseUrl": "https://api.deepseek.com/",
      "auth": { "type": "env", "envVar": "DEEPSEEK_API_KEY" },
      "match": {
        "models": [
          "deepseek-flash",
          "deepseek-pro"
        ]
      },
      "modelAliases": {
        "deepseek-pro": "deepseek-v4-pro"
      },
      "transforms": ["deepseek-effort", "deepseek-call-ids"]
    },
    {
      "id": "astrahub",
      "baseUrl": "https://www.astrahub-ai.com/v1/",
      "auth": { "type": "env", "envVar": "ASTRAHUB_API_KEY" },
      "match": { "models": ["as-kimi-k3", "as-deepseek-v4.1-flash", "as-glm-5.2"] },
      "modelAliases": {
        "as-kimi-k3": "kimi-k3",
        "as-deepseek-v4.1-flash": "deepseek-v4.1-flash",
        "as-glm-5.2": "GLM-5.2"
      }
    }
  ]
}
